# 复制为 server/.env 后按需修改。.env 不进 git，仓库里不出现任何真实密钥。

# ---- 运行 ----
# 默认只在本机回环地址监听（配合 adb reverse）。手机开热点、笔记本连热点时改成 0.0.0.0。
HOST=127.0.0.1
PORT=8000
# App 里填同一个令牌（Authorization: Bearer <APP_TOKEN>）
APP_TOKEN=dev-token
# 1 = 模拟模式：不调用外部服务，返回契约示例报告。只用于 Android 联调，路演时不要开。
MOCK_MODE=0

# ---- 大模型（OpenAI 兼容接口）。型号以控制台为准，默认开启思考模式的型号要关掉思考。----
LLM_PRIMARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=qwen3.7-plus
LLM_BACKUP_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=glm-5.3-flash
CROSS_CHECK=parallel

# ---- 文本向量（不填密钥时沿用 LLM_PRIMARY_API_KEY）----
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
CASES_SIMILARITY_THRESHOLD=0.5

# ---- 外部威胁情报（可选，只在配置了密钥时启用）----
INTEL_THREATBOOK_API_KEY=
INTEL_QIANXIN_API_KEY=
INTEL_TENCENT_SECRET_ID=
INTEL_TENCENT_SECRET_KEY=

# ---- 只用于断网模拟（见 README 第 6 节），平时保持注释 ----
# LINK_RDAP_BASE_URL=http://127.0.0.1:9/rdap
# LINK_WHOIS_SERVER=127.0.0.1

# ---- 媒体（P1：上传、图片 OCR、语音转写、合成语音检测）。需要 uv sync --extra media、ffmpeg 和权重，见 README ----
# 0 = 关闭：上传返回 503，鉴定里的媒体一律 not_analyzed
MEDIA_ENABLED=1
# 启动后在后台加载模型（语音转写首次加载约 20 多秒）。0 = 第一次用到时才加载
MEDIA_PRELOAD=1
# ffmpeg 不在 PATH 里时填它的完整路径（同目录下要有 ffprobe）
# FFMPEG_PATH=
# 以下保持默认即可
# MEDIA_MODELS_DIR=models
# MEDIA_MANIFEST_PATH=data/deepfake/weights.json
# 预处理（转写 / OCR）的时间预算，秒。流水线还会把它压到「整单 20 秒 − 汇总 − 话术 12 秒」之内
# MEDIA_PREPROCESS_BUDGET_S=6
# MEDIA_THREADS=4
# MEDIA_PROBE_TIMEOUT_S=10
# MEDIA_OCR_MIN_SCORE=0.5
# MEDIA_ASR_CHUNK_S=25
# MEDIA_SYNTHETIC_THRESHOLD=0.9
# MEDIA_GENUINE_THRESHOLD=0.1
# MEDIA_MIN_SPEECH_S=1
# MEDIA_SWEEP_INTERVAL_S=60
# MEDIA_PREPARED_TTL_S=120
# MEDIA_MAX_DERIVED_LINES=100
# 上传后多久没被鉴定引用就删除（最长 1 小时），以及各类型的大小、时长上限
# MEDIA_MAX_AGE_S=3600
# LIMIT_IMAGE_BYTES=5242880
# LIMIT_AUDIO_BYTES=10485760
# LIMIT_AUDIO_SECONDS=60
# LIMIT_VIDEO_BYTES=52428800
# LIMIT_VIDEO_SECONDS=30

# 其余配置项（各路超时、数量限制、限流、保留天数等）见 app/config.py，变量名是字段名的大写。
